{
  "uid": "go-web-service-observability",
  "title": "Observability stack",
  "tags": ["go-web-service", "observability"],
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 42,
  "version": 1,
  "time": { "from": "now-30m", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "refresh": "30s",
  "fiscalYearStartMonth": 0,
  "links": [],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "templating": { "list": [] },
  "panels": [
    {
      "type": "row",
      "id": 100,
      "title": "Collector",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "panels": []
    },
    {
      "type": "stat",
      "id": 1,
      "title": "Uptime",
      "description": "otelcol_process_uptime_total, seconds since the collector process started. A reset means the container restarted.",
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "mimir" },
          "expr": "max(otelcol_process_uptime_total)",
          "legendFormat": "uptime",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dtdurations",
          "decimals": 0,
          "color": { "mode": "fixed", "fixedColor": "green" },
          "noValue": "collector down"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "value",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      }
    },
    {
      "type": "stat",
      "id": 2,
      "title": "Memory (RSS)",
      "description": "otelcol_process_memory_rss, the collector's resident set size.",
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "mimir" },
          "expr": "max(otelcol_process_memory_rss)",
          "legendFormat": "rss",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "decimals": 0,
          "color": { "mode": "fixed", "fixedColor": "blue" },
          "noValue": "no data"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "value",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      }
    },
    {
      "type": "stat",
      "id": 3,
      "title": "CPU",
      "description": "rate of otelcol_process_cpu_seconds_total: the fraction of one core the collector is using.",
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "mimir" },
          "expr": "sum(rate(otelcol_process_cpu_seconds_total[$__rate_interval]))",
          "legendFormat": "cpu",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "color": { "mode": "fixed", "fixedColor": "blue" },
          "noValue": "no data"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "value",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      }
    },
    {
      "type": "stat",
      "id": 4,
      "title": "Service log connections",
      "description": "otelcol_tcp_input_active_connections on the tcp_log receiver (port 4319). 1 while `mise run serve` streams its stdout to the collector; 0 until the instrumentation task wires that up. The series only exists once a connection has been made, hence the `or vector(0)`.",
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "mimir" },
          "expr": "sum(otelcol_tcp_input_active_connections) or vector(0)",
          "legendFormat": "connections",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "text", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "noValue": "no data"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "value",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      }
    },
    {
      "type": "row",
      "id": 101,
      "title": "Pipelines: accepted by each receiver, sent by each exporter",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "panels": []
    },
    {
      "type": "timeseries",
      "id": 5,
      "title": "Metrics pipeline",
      "description": "Metric points per second through the metrics pipeline: accepted by each receiver (prometheus/self is the collector scraping itself; otlp is the service, once instrumented), sent by the prometheus_remote_write/mimir exporter, and failed sends. Accepted and sent tracking each other is the pipeline working.",
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 6 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "mimir" },
          "expr": "sum by (receiver) (rate(otelcol_receiver_accepted_metric_points_total[$__rate_interval]))",
          "legendFormat": "accepted by {{receiver}}",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "mimir" },
          "expr": "sum by (exporter) (rate(otelcol_exporter_sent_metric_points_total[$__rate_interval]))",
          "legendFormat": "sent by {{exporter}}",
          "range": true,
          "instant": false
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "mimir" },
          "expr": "sum by (exporter) (rate(otelcol_exporter_send_failed_metric_points_total[$__rate_interval]))",
          "legendFormat": "failed by {{exporter}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "axisPlacement": "auto",
            "stacking": { "mode": "none", "group": "A" }
          },
          "color": { "mode": "palette-classic" },
          "min": 0
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": "^failed .*" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": [] },
        "tooltip": { "mode": "multi", "sort": "none" }
      }
    },
    {
      "type": "timeseries",
      "id": 6,
      "title": "Logs pipeline",
      "description": "Log records per second through the logs pipeline: accepted by the tcp_log receiver, sent by the otlp_http/loki exporter, and failed sends. No data until the service streams its stdout to port 4319: the collector only creates these counters on their first increment.",
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 6 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "mimir" },
          "expr": "sum by (receiver) (rate(otelcol_receiver_accepted_log_records_total[$__rate_interval]))",
          "legendFormat": "accepted by {{receiver}}",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "mimir" },
          "expr": "sum by (exporter) (rate(otelcol_exporter_sent_log_records_total[$__rate_interval]))",
          "legendFormat": "sent by {{exporter}}",
          "range": true,
          "instant": false
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "mimir" },
          "expr": "sum by (exporter) (rate(otelcol_exporter_send_failed_log_records_total[$__rate_interval]))",
          "legendFormat": "failed by {{exporter}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "axisPlacement": "auto",
            "stacking": { "mode": "none", "group": "A" }
          },
          "color": { "mode": "palette-classic" },
          "min": 0
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": "^failed .*" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": [] },
        "tooltip": { "mode": "multi", "sort": "none" }
      }
    },
    {
      "type": "timeseries",
      "id": 7,
      "title": "Traces pipeline",
      "description": "Spans per second through the traces pipeline: accepted by the otlp receiver, sent by the otlp_grpc/tempo exporter, and failed sends. No data until the service exports spans over OTLP: the collector only creates these counters on their first increment.",
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 6 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "mimir" },
          "expr": "sum by (receiver) (rate(otelcol_receiver_accepted_spans_total[$__rate_interval]))",
          "legendFormat": "accepted by {{receiver}}",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "mimir" },
          "expr": "sum by (exporter) (rate(otelcol_exporter_sent_spans_total[$__rate_interval]))",
          "legendFormat": "sent by {{exporter}}",
          "range": true,
          "instant": false
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "mimir" },
          "expr": "sum by (exporter) (rate(otelcol_exporter_send_failed_spans_total[$__rate_interval]))",
          "legendFormat": "failed by {{exporter}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "axisPlacement": "auto",
            "stacking": { "mode": "none", "group": "A" }
          },
          "color": { "mode": "palette-classic" },
          "min": 0
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": "^failed .*" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": [] },
        "tooltip": { "mode": "multi", "sort": "none" }
      }
    },
    {
      "type": "row",
      "id": 102,
      "title": "Backends: the service's own signals",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "panels": []
    },
    {
      "type": "logs",
      "id": 8,
      "title": "Service logs (Loki)",
      "description": "The service's log stream in Loki, selected by the service_name label Loki derives from the service.name resource the tcp_log receiver sets. Empty until `mise run serve` streams to the collector. Once the service logs under a span, each entry carries a trace_id and the Loki datasource's derived field links it to the trace in Tempo.",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 15 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{service_name=\"go-web-service\"}",
          "queryType": "range",
          "maxLines": 200
        }
      ],
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "enableInfiniteScrolling": false,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      }
    },
    {
      "type": "table",
      "id": 9,
      "title": "Recent traces (Tempo)",
      "description": "TraceQL search in Tempo for the service's traces, newest first. Empty until the service exports spans over OTLP. Each trace id in the table opens the trace view, whose trace-to-logs link searches Loki for the same trace_id.",
      "datasource": { "type": "tempo", "uid": "tempo" },
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 15 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "tempo", "uid": "tempo" },
          "queryType": "traceql",
          "query": "{resource.service.name=\"go-web-service\"}",
          "limit": 20,
          "spss": 3,
          "tableType": "traces",
          "filters": []
        }
      ],
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": { "show": false, "reducer": ["sum"], "countRows": false, "fields": "" }
      }
    }
  ]
}
